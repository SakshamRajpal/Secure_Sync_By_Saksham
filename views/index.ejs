  <!-- Leaflet Heatmap Plugin with Multiple Fallbacks -->
  <script>
    window.heatmapPluginLoaded = false; // Global flag to track plugin loading
    function loadHeatmapPlugin() {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/leaflet.heat@0.2.0/dist/leaflet-heat.min.js';
      script.onload = () => {
        console.log('Leaflet Heatmap plugin loaded successfully from jsDelivr CDN');
        window.heatmapPluginLoaded = true;
      };
      script.onerror = () => {
        console.error('Failed to load leaflet-heat.js from jsDelivr CDN. Trying unpkg CDN...');
        const fallbackScript = document.createElement('script');
        fallbackScript.src = 'https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js';
        fallbackScript.onload = () => {
          console.log('Leaflet Heatmap plugin loaded successfully from unpkg CDN');
          window.heatmapPluginLoaded = true;
        };
        fallbackScript.onerror = () => {
          console.error('Failed to load leaflet-heat.js from unpkg CDN. Falling back to local copy...');
          const localScript = document.createElement('script');
          localScript.src = '/leaflet-heat.js';
          localScript.onload = () => {
            console.log('Leaflet Heatmap plugin loaded successfully from local copy');
            window.heatmapPluginLoaded = true;
          };
          localScript.onerror = () => {
            console.error('Failed to load leaflet-heat.js from local copy. Heatmap functionality will be disabled.');
            window.heatmapPluginLoaded = false;
          };
          document.head.appendChild(localScript);
        };
        document.head.appendChild(fallbackScript);
      };
      document.head.appendChild(script);
    }
    loadHeatmapPlugin();
  </script>
    
</head>
